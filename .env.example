# ==============================================================================
# SIH26155 Network Security Compliance Auditor - Environment Configuration
# ==============================================================================

# Database Configuration
# Leave DATABASE_URL unset/empty to run fully offline on local SQLite (air-gapped resilience mode).
# To connect to an external PostgreSQL database, configure your connection string below:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local AI / LLM Configuration (Ollama for air-gapped NTRO environment)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Demo & Security Settings
# When true, POST /api/audit-trail/demo-tamper mutates newest entry to demo tamper detection
AUDIT_TRAIL_DEMO_ENABLED=false
